{
  "permissions": {
    "allow": [
      "Read",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)"
    ],
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
